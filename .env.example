# Copie para .env e substitua os valores de exemplo.
PORT=3000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000

# OAuth Web Client ID criado no Google Cloud Console.
GOOGLE_CLIENT_ID=000000000000-exemplo.apps.googleusercontent.com
# Única conta Google autorizada a abrir o terminal.
EMAIL_ADMIN=admin@example.com

# Execução local: pasta atual e auditoria em ./data. O Compose usa /workspace e /data.
WORKDIR=.
COMMAND_HOME=
AUDIT_LOG_PATH=./data/audit.jsonl

# Limites de execução. As alterações exigem reiniciar o serviço.
MAX_ACTIVE_COMMANDS=3
MAX_COMMANDS_PER_MINUTE=20
MAX_COMMAND_DURATION_MS=300000
MAX_COMMAND_OUTPUT_BYTES=1048576
MAX_AUDIT_BYTES=10485760
AUDIT_RETENTION_DAYS=90
