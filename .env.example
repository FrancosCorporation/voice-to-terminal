# Voice-to-Terminal — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Porta do servidor
PORT=3000

# Google OAuth Client ID
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id_aqui

# Email do administrador (único usuário autorizado)
# Deve ser exatamente o email vinculado à conta Google
EMAIL_ADMIN=seu_email_pessoal_aqui
